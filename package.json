{
  "name": "priora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:prod": "npm run build && cross-env ELECTRON_PROD=1 electron .",
    "electron:smoke": "cross-env ELECTRON_PROD=1 ELECTRON_SMOKE=1 electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@untitledui/icons": "^0.0.22",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "^12.11.2",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.26.0",
    "postcss": "^8.5.13",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^6.2.3",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.2",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  },
  "description": "Priora: priorização investigativa probabilística (aplicativo desktop)",
  "author": "Equipe Priora",
  "build": {
    "appId": "br.com.priora.app",
    "productName": "Priora",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
